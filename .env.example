# Copy to .env and adjust. Without a .env the code runs its zero-download defaults
# (bm25, rerank rows, whole chunks, no translation); the values below are the recommended setup,
# the best configuration on the dev split (see the README's Results).

# Which model writes the answer: ollama (local, default) | anthropic (Claude API)
LLM_PROVIDER=ollama
# Defaults: qwen3:8b for ollama, claude-opus-5-5 for anthropic
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=

# Retrieval: bm25 (no download) | hybrid (BM25 + bge-m3 vectors: `ollama pull bge-m3`, then `arag embed`)
RETRIEVAL=hybrid
EMBEDDING_MODEL=bge-m3
TOP_K=6
# Also search with the question translated into the other language (one extra model call): 1 | 0
TRANSLATE_QUERY=1
# Rerank the top 30 chunks before answering: llm (the model picks) | rows (best single row, no model call) | none
RERANK=llm
# Show the model only this many best-matching rows of each table chunk (0 = whole 20-row chunks)
FOCUS_ROWS=3

# Corpus: datasets from this publisher on the Qatar Open Data portal
PORTAL_URL=https://www.data.gov.qa
PUBLISHER=National Planning Council
# Larger datasets are indexed as server-side totals (trade tables) or by their description card only
MAX_ROWS_PER_DATASET=30000
ROWS_PER_CHUNK=20

DATA_DIR=./data
