# Copy to .env and adjust. Every setting has a sensible default.

# Which model writes the answer: ollama (local, default) | anthropic (Claude API)
LLM_PROVIDER=ollama
# Defaults: qwen3:8b for ollama, claude-opus-5-5 for anthropic
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=

# Retrieval: bm25 (no download) | hybrid (BM25 + bge-m3 via Ollama: `ollama pull bge-m3`)
RETRIEVAL=bm25
EMBEDDING_MODEL=bge-m3
TOP_K=6
# Rerank the top 30 chunks before answering: rows (best single row, default) | llm (the model picks) | none
RERANK=rows

# Corpus: datasets from this publisher on the Qatar Open Data portal
PORTAL_URL=https://www.data.gov.qa
PUBLISHER=National Planning Council
# Datasets with more rows than this keep only their description card in the index
MAX_ROWS_PER_DATASET=5000
ROWS_PER_CHUNK=20

DATA_DIR=./data
